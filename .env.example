# A free Gemini API key from https://aistudio.google.com/apikey
LLM_API_KEY=your-api-key-here

# Optional overrides (defaults shown)
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_AUTH_HEADER=Authorization
# LLM_TEMPERATURE=1.0
# MAX_UPLOAD_CHARS=20000
# MAX_UPLOAD_MB=20
# VISITOR_AI_CALLS_PER_MINUTE=8
# VISITOR_AI_CALLS_PER_DAY=60
# Header with the visitor's real IP behind a proxy (True-Client-IP on Render). Empty: the
# connecting address. Never X-Forwarded-For, which visitors can fake.
# VISITOR_IP_HEADER=

# Any other OpenAI-compatible API works too, for example:
#   Groq:          LLM_API_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=openai/gpt-oss-20b
#   OpenRouter:    LLM_API_BASE_URL=https://openrouter.ai/api/v1
#   Ollama:        LLM_API_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.2  LLM_API_KEY=ollama
#   UvA AI Chat:   LLM_API_BASE_URL=https://llmproxy.uva.nl/v1  LLM_AUTH_HEADER=x-litellm-api-key
#                  LLM_MODEL=gpt-5.4-mini  LLM_TEMPERATURE=
# For OpenAI models, an empty LLM_TEMPERATURE uses each request's own temperature.

# Preload a Peer Reviewer ("Rae") and help requests for a live demo.
# DEMO=1
